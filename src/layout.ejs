<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= desc %>">
  <meta name="robots" content="<%= robots %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= SITE %><%= ogImage %>">
  <meta property="og:image:alt" content="<%= ogImageAlt %>">
  <meta property="og:site_name" content="SolveCalc">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="<%= item && item.img ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= desc %>">
  <meta name="twitter:image" content="<%= SITE %><%= ogImage %>">
  <meta name="twitter:image:alt" content="<%= ogImageAlt %>">
<% schema.forEach(function (obj) { %>
  <script type="application/ld+json"><%- JSON.stringify(obj).replace(/</g, '\\u003c') %></script>
<% }); %>
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/img/logo-512.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/logo-192.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/img/logo-48.png">
  <link rel="shortcut icon" href="/assets/img/logo-48.png" type="image/png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/logo-180.png">
  <meta name="theme-color" content="#4f46e5">
  <link rel="preload" as="image" href="/assets/img/solvecalc-calcsolver-logo.webp" fetchpriority="high">
  <%# The vault plays every game from this CDN, so the connection is opened
      before the first game card is ever clicked. %>
  <link rel="preconnect" href="https://learn.edumain.net" crossorigin>
  <link rel="preload" href="/assets/fonts/noto-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-KV0T3K6WSM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-KV0T3K6WSM');
  </script>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/vendor/fontawesome/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/assets/vendor/fontawesome/css/all.min.css"></noscript>
  <link rel="stylesheet" href="/assets/css/style.css?v=<%= ASSET_V %>">
<% if (vault) { %>
  <%# Vault and game-splash styling. On solvecalc.net this sits inline in the
      homepage; here it is a file so only the pages with the vault pay for it. %>
  <link rel="stylesheet" href="/assets/css/vault.css?v=<%= ASSET_V %>">
<% } %>
  <style>
    :root {
      --bg: #f6f7fb; --bg2: #ffffff; --bg3: #eef1f8;
      --card: #ffffff; --card-hover: #f7f9ff;
      --accent: #4f46e5; --accent2: #6366f1;
      --text: #1a202c; --text-muted: #4a5568; --border: #dfe3ec;
    }
    <%# The GBA emulator tab needs a server-side ROM proxy, which GitHub Pages
        cannot run, so it is not offered here. %>
    #vault-gba-tab { display: none !important; }
  </style>
</head>
<body class="<%= bodyClass %>">

<header>
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/assets/img/solvecalc-calcsolver-logo.webp" alt="SolveCalc - free calcsolver and scientific calculator" class="logo-wordmark" width="512" height="101" fetchpriority="high">
    </a>
    <span class="site-tagline">Free CalcSolver</span>
    <nav class="header-nav">
      <a href="/"<%= path === '/' ? ' class="active"' : '' %>>Calculator</a>
      <a href="/tools/"<%= path.startsWith('/tools') ? ' class="active"' : '' %>>Tools</a>
      <a href="/guides/"<%= path.startsWith('/guides') ? ' class="active"' : '' %>>Guides</a>
      <a href="/blog/"<%= path.startsWith('/blog') ? ' class="active"' : '' %>>Blog</a>
      <a href="/about/"<%= path === '/about' ? ' class="active"' : '' %>>About</a>
    </nav>
    <button class="mob-menu-btn" id="mob-menu-btn" aria-label="Menu">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
  <div class="mob-nav" id="mob-nav">
    <a href="/">Calculator</a>
    <a href="/tools/">Tools</a>
    <a href="/guides/">Guides</a>
    <a href="/blog/">Blog</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
  </div>
</header>

<main>
<%- body %>
</main>

<footer>
  <div class="footer-main">
    <div class="footer-col footer-col-brand">
      <a href="/" class="footer-brand logo" aria-label="SolveCalc">
        <img src="/assets/img/solvecalc-calcsolver-logo.webp" alt="SolveCalc calcsolver" class="logo-wordmark" width="512" height="101" loading="lazy">
      </a>
      <p class="footer-tagline">A free calcsolver that runs entirely in your browser: a full scientific calculator, focused math tools, and short guides. Nothing to install, no account to make.</p>
    </div>
    <div class="footer-col">
      <p class="footer-col-title">Explore</p>
      <nav class="footer-col-links">
        <a href="/">Calculator</a>
        <a href="/tools/">Math Tools</a>
        <a href="/guides/">Guides</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </nav>
    </div>
    <div class="footer-col">
      <p class="footer-col-title">Legal</p>
      <nav class="footer-col-links">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/sitemap.xml">Sitemap</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
    <div class="footer-col">
      <p class="footer-col-title">Project</p>
      <nav class="footer-col-links">
        <a href="https://github.com/solvecalc/solvecalc.github.io" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-github"></i> Source on GitHub</a>
        <a href="https://solvecalc.net" target="_blank" rel="noopener noreferrer">SolveCalc.net</a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">&copy; <%= YEAR %> SolveCalc. Hosted on GitHub Pages.</span>
  </div>
</footer>

<button id="scroll-top-btn" class="scroll-top-btn" aria-label="Scroll to top" title="Scroll to top">
  <i class="fa-solid fa-arrow-up"></i>
</button>
<script>
(function () {
  var btn = document.getElementById('scroll-top-btn');
  if (!btn) return;
  function tick() {
    var vault = document.getElementById('vault-overlay');
    var vaultOpen = vault && vault.classList.contains('open');
    btn.classList.toggle('visible', !vaultOpen && window.scrollY > 400);
  }
  window.addEventListener('scroll', tick, { passive: true });
  var vault = document.getElementById('vault-overlay');
  if (vault) new MutationObserver(tick).observe(vault, { attributes: true, attributeFilter: ['class'] });
  tick();
  btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
})();
(function () {
  var btn = document.getElementById('mob-menu-btn');
  var nav = document.getElementById('mob-nav');
  if (btn) btn.addEventListener('click', function () { nav.classList.toggle('open'); });
})();
</script>
<% if (vault) { %>
<%# main.js drives the calculator and the vault, and expects both to be in the
    page. Only the homepage has them, so other pages skip it entirely rather
    than loading a script that would throw on missing elements. %>
<script src="/assets/js/main.js?v=<%= ASSET_V %>"></script>
<% } %>
</body>
</html>
